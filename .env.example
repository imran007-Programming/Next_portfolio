# SMTP (Gmail example: use an App Password — https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_app_password

# Where contact form messages are delivered (defaults to SMTP_USER)
MAIL_TO=your.email@gmail.com

# From address shown in inbox (defaults to SMTP_USER)
MAIL_FROM=your.email@gmail.com
