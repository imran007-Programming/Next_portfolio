# Google Gemini API key for the chatbot — get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the model (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.8-flash

# Resend API key — get one free at https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Where emails are delivered (defaults to imranphero@gmail.com)
MAIL_TO=imranphero@gmail.com

# From address — must be a verified domain on Resend, or leave blank to use onboarding@resend.dev
# MAIL_FROM=Portfolio <you@yourdomain.com>
